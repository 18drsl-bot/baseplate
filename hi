local function pick(i)
	highlight(i)
	local m = MATS[i]
	if m.mat == nil then
		state.cleared = true
		local ok, e = pcall(clearAll)
		if ok then
			setStatus("Cleared terrain - baseplates kept", C.good)
		else
			setStatus("Error: " .. tostring(e), C.bad)
		end
	else
		state.cleared = false
		state.material = m.mat
		pcall(function() terrain:SetMaterialColor(m.mat, m.color) end)
		startJob(m.label)
	end
end

for i = 1, #MATS do
	track(matBtns[i].Activated:Connect(function() pick(i) end))
end

