-- KEEP TERRAIN FOLLOWING YOU + PICK UP NEW BASEPLATES
-- ============================================================

local acc = 0
track(RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if acc < 0.4 then return end
	acc = 0
	if running or state.cleared or not applied.mat then return end
	local f = focusPoint()
	if dirty or not lastFocus or flatDist(f, lastFocus) > FOLLOW_STEP then
		dirty = false
		startJob("Auto", { topUp = true })
	end
end))

track(workspace.DescendantAdded:Connect(function(d)
	if not d:IsA("BasePart") then return end
	local s = d.Size
	if not (s.X > 100 or s.Z > 100 or nameLooksLikeFloor(d.Name)) then return end
	task.delay(0.3, function()
		if state.cleared or plates[d] or not d.Parent then return end
		if isBaseplate(d) then
			if fakePlate then
				-- a real baseplate showed up, so replace the stand-in floor
				plates[fakePlate] = nil
				plateTiles[fakePlate] = nil
				fakePlate = nil
				state.needClear = true
				plates[d] = true
				startJob("Auto")
			else
				plates[d] = true
				dirty = true
			end
		end
	end)
end))

