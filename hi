-- ============================================================
-- TERRAIN LOGIC
-- ============================================================

local function nameLooksLikeFloor(name)
	local n = string.lower(name)
	return string.find(n, "baseplate", 1, true) ~= nil
		or string.find(n, "floor", 1, true) ~= nil
		or string.find(n, "ground", 1, true) ~= nil
end

local function isBaseplate(p)
	if not p:IsA("BasePart") or p:IsA("Terrain") then return false end
	if not p.CanCollide and p.Transparency == 1 then return false end
	local s = p.Size
	if s.Y > 50 then return false end
	if math.abs(p.CFrame.UpVector.Y) < 0.9 then return false end
	return (s.X > 100 and s.Z > 100) or nameLooksLikeFloor(p.Name)
end

-- Baseplate becomes invisible but stays solid, so walking height stays exact
local function hide(p)
	if p == fakePlate then return end
	if origTrans[p] == nil then origTrans[p] = p.Transparency end
	p.Transparency = 1
	p.CanCollide = true
end

local function scan()
	for _, d in ipairs(workspace:GetDescendants()) do
		if isBaseplate(d) then plates[d] = true end
	end
end

-- Used only when the game has no baseplate at all (flat 2000x2000 floor at y = 0)
local function makeFallback()
	fakePlate = {
		Parent = true,
		Transparency = 0,
		CanCollide = true,
		Size = Vector3.new(2000, 4, 2000),
		CFrame = CFrame.new(0, DROP - 2, 0),
	}
	plates[fakePlate] = true
end

-- Splits one baseplate into square tiles so it can be built a few at a time
local function buildTiles(p, mult)
	local s = p.Size
	local sx, sz = s.X * mult, s.Z * mult
	local nx = math.max(1, math.ceil(sx / TILE))
	local nz = math.max(1, math.ceil(sz / TILE))
	local cx, cz = sx / nx, sz / nz
	local localY = (s.Y / 2 - DROP) - FILL_DEPTH / 2
	local base = p.CFrame * CFrame.new(0, localY, 0)
	-- tiles overlap by one voxel so no seams show between them
	local tileSize = Vector3.new(cx + (nx > 1 and 4 or 0), FILL_DEPTH, cz + (nz > 1 and 4 or 0))
	local list = {}
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local cf = base * CFrame.new(-sx / 2 + cx * (ix + 0.5), 0, -sz / 2 + cz * (iz + 0.5))
			list[#list + 1] = { cf = cf, size = tileSize, pos = cf.Position, plate = p, d = 0 }
		end
	end
	return list
end

local function getTiles(p)
	local e = plateTiles[p]
	if not e or e.mult ~= applied.mult then
		e = { mult = applied.mult, list = buildTiles(p, applied.mult) }
		plateTiles[p] = e
	end
	return e.list
end

local function focusPoint()
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then return hrp.Position end
	local cam = workspace.CurrentCamera
	if cam then return cam.CFrame.Position end
	return Vector3.new(0, 0, 0)
end

local function flatDist(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Finds every tile near the player that still needs building
local function collect(focus)
	local pending, remain, partial, count = {}, {}, false, 0
	for p in pairs(plates) do
		if p.Parent then
			count = count + 1
			for _, t in ipairs(getTiles(p)) do
				local d = flatDist(t.pos, focus)
				if d <= RADIUS then
					if not filled[t] then
						t.d = d
						pending[#pending + 1] = t
						remain[p] = (remain[p] or 0) + 1
					end
				else
					partial = true
				end
			end
		else
			plates[p] = nil
			plateTiles[p] = nil
		end
	end
	return pending, remain, partial, count
end

-- Builds terrain closest-to-you first, a few milliseconds per frame, so the game never freezes.
-- A newer click cancels the older job.
local function startJob(label, opts)
	opts = opts or {}
	jobId = jobId + 1
	local id = jobId
	running = true
	task.spawn(function()
		local ok, res = pcall(function()
			local focus = focusPoint()
			lastFocus = focus
			if not opts.topUp then
				applied.mat, applied.mult = state.material, state.mult
				filled = {}
			end
			local mat = applied.mat
			local pending, remain, partial, count = collect(focus)

			if not opts.topUp then
				if count == 0 then
					pcall(scan)
					if next(plates) == nil then makeFallback() end
					pending, remain, partial, count = collect(focus)
				end
				-- Only wipe terrain when it is really needed (size change, refresh, big maps)
				if state.needClear or opts.forceClear or state.lastMult ~= applied.mult
					or (partial and state.lastMat ~= mat) then
					terrain:Clear()
					state.needClear = false
					filled = {}
				end
				state.lastMult, state.lastMat = applied.mult, mat
				pcall(function() terrain.Decoration = state.decor end)
			end

			table.sort(pending, function(a, b) return a.d < b.d end)

			local total, done, fails, firstErr = #pending, 0, 0, nil
			local bad = {}
			local t0 = os.clock()
			for _, t in ipairs(pending) do
				if id ~= jobId then return nil end
				local okFill, e = pcall(terrain.FillBlock, terrain, t.cf, t.size, mat)
				local p = t.plate
				if okFill then
					filled[t] = true
				else
					bad[p] = true
					fails = fails + 1
					firstErr = firstErr or tostring(e)
				end
				done = done + 1
				remain[p] = remain[p] - 1
				if remain[p] == 0 and not bad[p] then pcall(hide, p) end
				if os.clock() - t0 > BUDGET then
					if not opts.topUp then
						setStatus(label .. ": " .. math.floor(done / total * 100) .. "%", C.warn)
					end
					task.wait()
					t0 = os.clock()
				end
			end
			return { count = count, partial = partial, fails = fails, err = firstErr, total = total }
		end)

		if id ~= jobId then return end   -- a newer job took over
		running = false

		if not ok then
			setStatus("Error: " .. tostring(res), C.bad)
			warn("[TerrainGUI] " .. tostring(res))
		elseif res then
			if res.fails > 0 then
				setStatus(label .. ": " .. res.fails .. " tile(s) failed: " .. tostring(res.err), C.bad)
				warn("[TerrainGUI] " .. tostring(res.err))
			elseif not opts.topUp then
				if fakePlate then
					setStatus(label .. ": no baseplate found, used flat floor", C.warn)
				elseif res.partial then
					setStatus(label .. ": done (" .. res.count .. " plate(s), builds around you)", C.good)
				else
					setStatus(label .. ": done (" .. res.count .. " plate(s))", C.good)
				end
			end
		end
	end)
end

-- Wipes terrain only. Baseplates are kept and made visible again.
local function clearAll()
	jobId = jobId + 1       -- cancels any build in progress
	running = false
	terrain:Clear()
	filled = {}
	state.lastMult = nil
	for p in pairs(plates) do
		if p ~= fakePlate then
			if p.Parent then
				local o = origTrans[p]
				if o == nil or o > 0.9 then o = 0 end
				p.Transparency = o
				p.CanCollide = true
			else
				plates[p] = nil
				plateTiles[p] = nil
			end
		end
	end
end

