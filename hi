-- NEW BASEPLATES (streaming / respawned maps)
-- ============================================================

track(workspace.DescendantAdded:Connect(function(d)
	if not d:IsA("BasePart") then return end
	local s = d.Size
	if not (s.X > 100 or s.Z > 100 or nameLooksLikeFloor(d.Name)) then return end
	task.delay(0.3, function()
		if plates[d] or not d.Parent then return end
		if not isBaseplate(d) then return end
		plates[d] = true
		if state.cleared then return end
		if not state.hadPlate then
			-- the game's real baseplate just loaded, so rebuild at its height
			computeGround()
			beginBuild(state.label, true)
		elseif state.active and not state.needHide then
			pcall(hide, d)
		end
	end)
end))

