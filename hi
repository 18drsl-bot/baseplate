-- ============================================================
-- TERRAIN FUNCTIONS  (cached baseplates = no per-click scanning)
-- ============================================================

local currentMaterial = Enum.Material.Grass
local currentMult = 1.0

-- Cache of found baseplates so clicks never re-scan the workspace
local cachedPlates = {}

local function isBaseplate(p)
	if not p:IsA("BasePart") then return false end
	if not p.CanCollide and p.Transparency == 1 then return false end
	local n = string.lower(p.Name)
	local named = string.find(n,"baseplate") or string.find(n,"floor") or string.find(n,"ground")
	local flat = math.abs(p.CFrame.UpVector.Y) > 0.9
	return ((p.Size.X > 100 and p.Size.Z > 100) or named) and p.Size.Y < 20 and flat
end

-- Scan once and store results
local function buildCache()
	cachedPlates = {}
	for _, p in ipairs(workspace:GetDescendants()) do
		if isBaseplate(p) then
			table.insert(cachedPlates, p)
		end
	end
end

-- Fill terrain from cache — fast, no scanning
local function applyFromCache()
	pcall(function() workspace.Terrain:Clear() end)
	if #cachedPlates == 0 then
		-- Fallback flat fill
		pcall(function()
			workspace.Terrain:FillBlock(
				CFrame.new(0,-2,0),
				Vector3.new(2000*currentMult, 4, 2000*currentMult),
				currentMaterial
			)
		end)
		return
	end
	for _, p in ipairs(cachedPlates) do
		if p and p.Parent then
			pcall(function()
				local s = p.Size
				workspace.Terrain:FillBlock(
					p.CFrame * CFrame.new(0,-2.5,0),
					Vector3.new(s.X*currentMult, s.Y, s.Z*currentMult),
					currentMaterial
				)
				p.Transparency = 1
				p.CanCollide = true
			end)
		end
	end
end

local function clearOnly()
	pcall(function() workspace.Terrain:Clear() end)
	for _, p in ipairs(cachedPlates) do
		if p and p.Parent then
			p.Transparency = 0
		end
	end
end

-- Full rescan + apply (used on init and when new big parts appear)
local function reapply()
	buildCache()
	applyFromCache()
end

-- ============================================================
-- SLIDER LOGIC
-- ============================================================

local SMIN, SMAX = 0.25, 3.0
local snorm = (1.0 - SMIN) / (SMAX - SMIN)

local function setSlider(n)
	n = math.clamp(n, 0, 1)
	snorm = n
	sliderFill.Size = UDim2.new(n, 0, 1, 0)
	knob.Position = UDim2.new(n, 0, 0.5, 0)
	currentMult = SMIN + n * (SMAX - SMIN)
	sizeVal.Text = string.format("%.2fx", currentMult)
end

setSlider(snorm)

local dragging = false
knob.MouseButton1Down:Connect(function() dragging = true end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
UIS.InputChanged:Connect(function(i)
	if not dragging then return end
	if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
		local ap = track.AbsolutePosition
		local as = track.AbsoluteSize
		if as.X > 0 then
			setSlider((i.Position.X - ap.X) / as.X)
		end
	end
end)

-- ============================================================
-- BUTTON CLICKS
-- ============================================================

for i, m in ipairs(MATS) do
	matBtns[i].MouseButton1Click:Connect(function()
		selectBtn(i)
		if m.mat == nil then
			-- Clear: wipe terrain, restore baseplate visibility
			clearOnly()
			workspace.Terrain.Decoration = false
		else
			-- Instant: just set material + fill from cache, no scanning
			currentMaterial = m.mat
			workspace.Terrain.Decoration = true
			pcall(function() workspace.Terrain:SetMaterialColor(m.mat, m.color) end)
			applyFromCache()
		end
	end)
end

applyBtn.MouseButton1Click:Connect(function()
	local m = MATS[selectedIdx]
	if m.mat ~= nil then
		currentMaterial = m.mat
		workspace.Terrain.Decoration = true
		pcall(function() workspace.Terrain:SetMaterialColor(m.mat, m.color) end)
		applyFromCache()
	end
end)

