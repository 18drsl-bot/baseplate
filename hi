local selectedIdx = 1
local function highlight(i)
	matBtns[selectedIdx].BackgroundColor3 = C.btn
	matBtns[selectedIdx].TextColor3 = C.btnText
	selectedIdx = i
	matBtns[i].BackgroundColor3 = C.btnSel
	matBtns[i].TextColor3 = C.text
end

local function pick(i)
	highlight(i)
	local m = MATS[i]
	if m.mat == nil then
		state.cleared = true
		local ok, e = pcall(clearAll)
		if ok then
			setStatus("Cleared terrain - baseplates kept", C.good)
		else
			setStatus("Error: " .. tostring(e), C.bad)
		end
	else
		state.cleared = false
		state.material = m.mat
		pcall(function()
			terrain.Decoration = (m.mat == Enum.Material.Grass)
			terrain:SetMaterialColor(m.mat, m.color)
		end)
		runApply(m.label)
	end
end

for i = 1, #MATS do
	track(matBtns[i].MouseButton1Click:Connect(function() pick(i) end))
end

track(applyBtn.MouseButton1Click:Connect(function()
	for p in pairs(plates) do plates[p] = nil end
	pcall(scan)
	if MATS[selectedIdx].mat == nil then
		setStatus("Rescanned - pick a material to apply", C.warn)
	else
		runApply(MATS[selectedIdx].label)
	end
end))

