local SMIN, SMAX = 0.25, 3.0
local function setSlider(n)
	n = math.clamp(n, 0, 1)
	sliderFill.Size = UDim2.new(n, 0, 1, 0)
	knob.Position = UDim2.new(n, 0, 0.5, 0)
	state.mult = SMIN + n * (SMAX - SMIN)
	sizeVal.Text = string.format("%.2fx", state.mult)
end
setSlider((1.0 - SMIN) / (SMAX - SMIN))

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local sliding, slideMoved = false, false
local function slideTo(x)
	local ap, as = sliderTrack.AbsolutePosition, sliderTrack.AbsoluteSize
	if as.X > 0 then
		setSlider((x - ap.X) / as.X)
		slideMoved = true
	end
end
local function startSlide(i)
	if isPress(i) then
		sliding = true
		slideTo(i.Position.X)
	end
end
track(sliderHit.InputBegan:Connect(startSlide))
track(knob.InputBegan:Connect(startSlide))

local function viewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

local function updateScale()
	local vp = viewport()
	local s = math.min(1, (vp.Y - 20) / fullH, (vp.X - 20) / W)
	uiScale.Scale = math.max(0.5, s)
end

-- keeps the window from being dragged off screen
local function clampToScreen()
	local vp = viewport()
	local ap, as = main.AbsolutePosition, main.AbsoluteSize
	local dx, dy = 0, 0
	if ap.X < 0 then dx = -ap.X elseif ap.X + as.X > vp.X then dx = vp.X - ap.X - as.X end
	if ap.Y < 0 then dy = -ap.Y elseif ap.Y + as.Y > vp.Y then dy = vp.Y - ap.Y - as.Y end
	if dx ~= 0 or dy ~= 0 then
		local sc = uiScale.Scale
		local pos = main.Position
		main.Position = UDim2.new(pos.X.Scale, pos.X.Offset + dx / sc, pos.Y.Scale, pos.Y.Offset + dy / sc)
	end
end

updateScale()
local cam0 = workspace.CurrentCamera
if cam0 then
	track(cam0:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		updateScale()
		task.defer(clampToScreen)
	end))
end

local dStart, dPos
track(titleBar.InputBegan:Connect(function(i)
	if isPress(i) then
		dStart = i.Position
		dPos = main.Position
	end
end))

track(UIS.InputChanged:Connect(function(i)
	if not isMove(i) then return end
	if sliding then
		slideTo(i.Position.X)
	elseif dStart then
		local d = (i.Position - dStart) / uiScale.Scale
		main.Position = UDim2.new(dPos.X.Scale, dPos.X.Offset + d.X, dPos.Y.Scale, dPos.Y.Offset + d.Y)
	end
end))

track(UIS.InputEnded:Connect(function(i)
	if not isPress(i) then return end
	if dStart then
		dStart = nil
		clampToScreen()
	end
	if sliding then
		sliding = false
		-- letting go of the slider rebuilds at the new size
		if slideMoved and not state.cleared then
			startJob(MATS[selectedIdx].label)
		end
		slideMoved = false
	end
end))

local collapsed = false
track(colBtn.Activated:Connect(function()
	collapsed = not collapsed
	content.Visible = not collapsed
	colBtn.Text = collapsed and "+" or "-"
	main.Size = UDim2.new(0, W, 0, collapsed and TH or fullH)
end))

