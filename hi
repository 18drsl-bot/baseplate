-- ============================================================
-- AUTO-CONVERTER (rescans only when new big parts appear)
-- ============================================================

if getgenv().TerrainAutoConverter then
	getgenv().TerrainAutoConverter:Disconnect()
end

local autoDebounce = false
getgenv().TerrainAutoConverter = workspace.DescendantAdded:Connect(function(p)
	if not p:IsA("BasePart") then return end
	local n = string.lower(p.Name)
	local isFloor = string.find(n,"baseplate") or string.find(n,"floor") or string.find(n,"ground")
	if isFloor or p.Size.X > 50 or p.Size.Z > 50 then
		if not autoDebounce then
			autoDebounce = true
			task.delay(1.5, function()
				if MATS[selectedIdx].mat ~= nil then
					reapply()
				end
				autoDebounce = false
			end)
		end
	end
end)

