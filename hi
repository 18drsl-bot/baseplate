-- ============================================================
-- BASEPLATES (found only to match the ground height and hide them)
-- ============================================================

local function nameLooksLikeFloor(name)
	local n = string.lower(name)
	return string.find(n, "baseplate", 1, true) ~= nil
		or string.find(n, "floor", 1, true) ~= nil
		or string.find(n, "ground", 1, true) ~= nil
end

local function isBaseplate(p)
	if not p:IsA("BasePart") or p:IsA("Terrain") then return false end
	if not p.CanCollide and p.Transparency == 1 then return false end
	local s = p.Size
	if s.Y > 50 then return false end
	if math.abs(p.CFrame.UpVector.Y) < 0.9 then return false end
	return (s.X > 100 and s.Z > 100) or nameLooksLikeFloor(p.Name)
end

-- Baseplate becomes invisible but stays solid, so walking height stays exact
local function hide(p)
	if origTrans[p] == nil then origTrans[p] = p.Transparency end
	p.Transparency = 1
	p.CanCollide = true
end

local function hideAll()
	for p in pairs(plates) do
		if p.Parent then
			pcall(hide, p)
		else
			plates[p] = nil
		end
	end
end

local function restorePlates()
	for p in pairs(plates) do
		if p.Parent then
			local o = origTrans[p]
			if o == nil or o > 0.9 then o = 0 end
			p.Transparency = o
			p.CanCollide = true
		else
			plates[p] = nil
		end
	end
end

local function scan()
	for _, d in ipairs(workspace:GetDescendants()) do
		if isBaseplate(d) then plates[d] = true end
	end
end

-- Ground height = top of the biggest baseplate (or 0 if the game has none)
local function computeGround()
	local best, bestArea = nil, -1
	for p in pairs(plates) do
		if p.Parent then
			local s = p.Size
			if s.X * s.Z > bestArea then
				bestArea = s.X * s.Z
				best = p
			end
		else
			plates[p] = nil
		end
	end
	state.hadPlate = best ~= nil
	if best then
		state.topY = best.Position.Y + best.Size.Y / 2 - DROPS[state.dropIdx]
	else
		state.topY = 0
	end
end

-- ============================================================
-- ENDLESS GROUND
-- ============================================================

local function focusPoint()
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then return hrp.Position end
	local cam = workspace.CurrentCamera
	if cam then return cam.CFrame.Position end
	return Vector3.new(0, 0, 0)
end

local function flatDist(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function keyOf(cx, cz)
	return (cx + 20000) * 40001 + (cz + 20000)
end

-- Bump strength for the current material (only grass is choppy)
local function currentAmp()
	if state.material == Enum.Material.Grass then
		return CHOPS[state.chopIdx].amp
	end
	return 0
end

-- Works out which chunks to add (nearest first) and which far ones to remove
local function plan(f)
	lastFocus = f
	queue, qi = {}, 1
	local R = state.range
	local mat, amp = state.material, currentAmp()
	local span = math.ceil(R / CHUNK) + 1
	local fcx, fcz = math.floor(f.X / CHUNK), math.floor(f.Z / CHUNK)
	for cx = fcx - span, fcx + span do
		for cz = fcz - span, fcz + span do
			local x, z = cx * CHUNK + CHUNK / 2, cz * CHUNK + CHUNK / 2
			local dx, dz = x - f.X, z - f.Z
			local d = math.sqrt(dx * dx + dz * dz)
			if d <= R then
				local k = keyOf(cx, cz)
				local c = built[k]
				if not c or c.mat ~= mat or c.amp ~= amp then
					queue[#queue + 1] = { key = k, x = x, z = z, d = d }
				end
			end
		end
	end
	table.sort(queue, function(a, b) return a.d < b.d end)
	local ur = R + UNLOAD_MARGIN
	for k, c in pairs(built) do
		local dx, dz = c.x - f.X, c.z - f.Z
		if math.sqrt(dx * dx + dz * dz) > ur then
			queue[#queue + 1] = { key = k, unload = true }
		end
	end
end

-- Builds one chunk. Flat ground is a single block; choppy grass is a grid of columns.
-- Every column starts from the same level top and only dips down by its bump depth.
-- (FillBlock only, so it works anywhere FillBlock works.)
local function writeChunk(item, mat, amp, rebuild)
	local top = state.topY
	local yMin = top - FILL_DEPTH - AMP_MAX - 4
	local yMax = top + 4
	local x0, z0 = item.x - CHUNK / 2, item.z - CHUNK / 2

	if amp <= 0 then
		terrain:FillBlock(
			CFrame.new(item.x, top - FILL_DEPTH / 2, item.z),
			Vector3.new(CHUNK, FILL_DEPTH, CHUNK),
			mat
		)
		return yMin, yMax
	end

	if rebuild then
		-- clear everything above the lowest possible bump so older, higher ground doesn't stay behind
		local lo = top - AMP_MAX
		terrain:FillBlock(
			CFrame.new(item.x, (lo + yMax) / 2, item.z),
			Vector3.new(CHUNK, yMax - lo, CHUNK),
			Enum.Material.Air
		)
	end

	local cfg = CHOPS[state.chopIdx]
	local cell, scale = cfg.cell, cfg.scale
	local n = CHUNK / cell
	local bottom = top - amp - FILL_DEPTH
	for ix = 1, n do
		local wx = x0 + (ix - 0.5) * cell
		for iz = 1, n do
			local wz = z0 + (iz - 0.5) * cell
			local v = math.noise(wx / scale, wz / scale, 0.37) * 1.2
				+ math.noise(wx / (scale * 0.4), wz / (scale * 0.4), 5.11) * 0.6
			local depth = amp * math.clamp(v + 0.5, 0, 1)
			local h = (top - depth) - bottom
			terrain:FillBlock(CFrame.new(wx, bottom + h / 2, wz), Vector3.new(cell, h, cell), mat)
		end
	end
	return yMin, yMax
end

local function processItem(item)
	if item.unload then
		local c = built[item.key]
		if c then
			pcall(terrain.FillBlock, terrain, CFrame.new(c.x, (c.yMin + c.yMax) / 2, c.z),
				Vector3.new(CHUNK, c.yMax - c.yMin, CHUNK), Enum.Material.Air)
			built[item.key] = nil
			builtCount = builtCount - 1
		end
		return
	end
	local mat, amp = state.material, currentAmp()
	local old = built[item.key]
	if old and old.mat == mat and old.amp == amp then return end
	local ok, a, b = pcall(writeChunk, item, mat, amp, old ~= nil)
	if ok then
		if not old then builtCount = builtCount + 1 end
		built[item.key] = { x = item.x, z = item.z, yMin = a, yMax = b, mat = mat, amp = amp }
		if state.needHide then
			state.needHide = false
			hideAll()
		end
	else
		-- stop instead of repeating the same error every frame
		state.active = false
		announce = false
		queue, qi = {}, 1
		setStatus("Error: " .. tostring(a), C.bad)
		warn("[TerrainGUI] " .. tostring(a))
	end
end

local function beginBuild(label, wipe)
	state.cleared = false
	state.active = true
	state.label = label
	state.needHide = true
	announce = true
	if wipe then
		pcall(function() terrain:Clear() end)
		built, builtCount = {}, 0
	end
	dirty = true
	planTimer = 1   -- plan on the very next frame
	setStatus(label .. ": starting...", C.warn)
end

local function refreshAll(label)
	for p in pairs(plates) do plates[p] = nil end
	pcall(scan)
	computeGround()
	beginBuild(label, true)
end

-- Wipes terrain only. Baseplates are kept and made visible again.
local function clearAll()
	state.active = false
	state.cleared = true
	announce = false
	queue, qi = {}, 1
	built, builtCount = {}, 0
	terrain:Clear()
	restorePlates()
end

track(RunService.Heartbeat:Connect(function(dt)
	if not state.active then return end

	planTimer = planTimer + dt
	if planTimer >= 0.25 then
		planTimer = 0
		local f = focusPoint()
		if dirty or not lastFocus or flatDist(f, lastFocus) > 32 then
			dirty = false
			plan(f)
		end
	end

	if qi > #queue then
		if announce then
			announce = false
			setStatus(state.label .. ": ready - ground grows as you move (" .. builtCount .. " chunks)", C.good)
		end
		return
	end

	local t0 = os.clock()
	while qi <= #queue and os.clock() - t0 < BUDGET do
		local item = queue[qi]
		qi = qi + 1
		processItem(item)
		if not state.active then return end
	end

	if announce and qi <= #queue then
		statusTimer = statusTimer + dt
		if statusTimer > 0.2 then
			statusTimer = 0
			setStatus(state.label .. ": building (" .. (#queue - qi + 1) .. " left)", C.warn)
		end
	end
end))

