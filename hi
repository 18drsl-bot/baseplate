-- ============================================================
-- TERRAIN LOGIC
-- ============================================================

local state = { material = Enum.Material.Grass, mult = 1, cleared = false }
local plates = {}            -- set of baseplate parts: part -> true
local MIN_THICK = 8          -- thin baseplates still get a visible terrain layer
local CHUNK = 1024           -- big baseplates are filled in pieces so FillBlock never fails
local DROP = 2.5             -- terrain top sits this far below the baseplate surface

local function nameLooksLikeFloor(name)
	local n = string.lower(name)
	return string.find(n, "baseplate", 1, true) ~= nil
		or string.find(n, "floor", 1, true) ~= nil
		or string.find(n, "ground", 1, true) ~= nil
end

local function isBaseplate(p)
	if not p:IsA("BasePart") or p:IsA("Terrain") then return false end
	if not p.CanCollide and p.Transparency == 1 then return false end
	local s = p.Size
	if s.Y > 50 then return false end
	if math.abs(p.CFrame.UpVector.Y) < 0.9 then return false end
	return (s.X > 100 and s.Z > 100) or nameLooksLikeFloor(p.Name)
end

local function fillBox(cf, size, material)
	local nx = math.max(1, math.ceil(size.X / CHUNK))
	local nz = math.max(1, math.ceil(size.Z / CHUNK))
	local cx, cz = size.X / nx, size.Z / nz
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local ox = -size.X / 2 + cx * (ix + 0.5)
			local oz = -size.Z / 2 + cz * (iz + 0.5)
			terrain:FillBlock(cf * CFrame.new(ox, 0, oz), Vector3.new(cx, size.Y, cz), material)
		end
	end
end

local function fillPlate(p)
	local s = p.Size
	local th = math.max(s.Y, MIN_THICK)
	local localY = (s.Y / 2 - DROP) - th / 2
	fillBox(
		p.CFrame * CFrame.new(0, localY, 0),
		Vector3.new(s.X * state.mult, th, s.Z * state.mult),
		state.material
	)
end

-- Baseplate becomes invisible but stays solid, so walking height stays exact
local function hide(p)
	if origTrans[p] == nil then origTrans[p] = p.Transparency end
	p.Transparency = 1
	p.CanCollide = true
end

local function scan()
	for _, d in ipairs(workspace:GetDescendants()) do
		if isBaseplate(d) then plates[d] = true end
	end
end

local function fillKnown()
	local n, err = 0, nil
	for p in pairs(plates) do
		if p.Parent then
			local ok, e = pcall(fillPlate, p)
			if ok then
				hide(p)
				n = n + 1
			else
				err = err or tostring(e)
			end
		else
			plates[p] = nil
		end
	end
	return n, err
end

-- returns: plateCount, firstError, usedFallback
local function applyAll()
	terrain:Clear()
	local n, err = fillKnown()
	if n == 0 then
		scan()
		n, err = fillKnown()
	end
	if n == 0 then
		fillBox(CFrame.new(0, -2, 0), Vector3.new(2000 * state.mult, 4, 2000 * state.mult), state.material)
		return 0, err, true
	end
	return n, err, false
end

-- Wipes terrain only. Baseplates are kept and made visible again.
local function clearAll()
	terrain:Clear()
	for p in pairs(plates) do
		if p.Parent then
			local o = origTrans[p]
			if o == nil or o > 0.9 then o = 0 end
			p.Transparency = o
			p.CanCollide = true
		else
			plates[p] = nil
		end
	end
end

local function runApply(label)
	local ok, a, b, c = pcall(applyAll)
	if not ok then
		setStatus("Error: " .. tostring(a), C.bad)
		warn("[TerrainGUI] " .. tostring(a))
	elseif c then
		setStatus(label .. ": no baseplate found, used flat fill", C.warn)
	elseif b then
		setStatus(label .. ": " .. a .. " plate(s) done, some failed", C.warn)
		warn("[TerrainGUI] " .. tostring(b))
	else
		setStatus(label .. ": applied to " .. a .. " baseplate(s)", C.good)
	end
end

