local selectedIdx = 1
local function highlight(i)
	matBtns[selectedIdx].BackgroundColor3 = C.btn
	matBtns[selectedIdx].TextColor3 = C.btnText
	selectedIdx = i
	matBtns[i].BackgroundColor3 = C.btnSel
	matBtns[i].TextColor3 = C.text
end

local function pick(i)
	highlight(i)
	local m = MATS[i]
	if m.mat == nil then
		local ok, e = pcall(clearAll)
		if ok then
			setStatus("Cleared terrain - baseplates kept", C.good)
		else
			setStatus("Error: " .. tostring(e), C.bad)
		end
	else
		state.material = m.mat
		pcall(function()
			terrain.Decoration = state.decor
			terrain:SetMaterialColor(m.mat, m.color)
		end)
		beginBuild(m.label, false)
	end
end

for i = 1, #MATS do
	track(matBtns[i].Activated:Connect(function() pick(i) end))
end

track(refreshBtn.Activated:Connect(function()
	if MATS[selectedIdx].mat == nil then
		for p in pairs(plates) do plates[p] = nil end
		pcall(scan)
		computeGround()
		setStatus("Rescanned - pick a material to build", C.warn)
	else
		refreshAll(MATS[selectedIdx].label)
	end
end))

local function refreshDecorText()
	decorBtn.Text = "Blades: " .. (state.decor and "On" or "Off")
end
refreshDecorText()
track(decorBtn.Activated:Connect(function()
	state.decor = not state.decor
	refreshDecorText()
	pcall(function() terrain.Decoration = state.decor end)
end))

-- Drop: how far below the baseplate the grass sits (same level everywhere)
local function refreshDropText()
	dropBtn.Text = "Drop: " .. DROPS[state.dropIdx]
end
refreshDropText()
track(dropBtn.Activated:Connect(function()
	state.dropIdx = state.dropIdx % #DROPS + 1
	refreshDropText()
	computeGround()
	if state.active then
		beginBuild(state.label, true)   -- the level changed, so rebuild from scratch
	end
end))

